NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<username>:<encoded-password>@<cluster>.mongodb.net/taskflow-ai?retryWrites=true&w=majority&appName=<app-name>
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ALLOW_ROLE_SELECTION=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Comma-separated list of allowed frontend origins (for CORS)
CLIENT_URL=http://localhost:5173,https://your-vercel-app.vercel.app

